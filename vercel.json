{
  "redirects": [
    {
      "source": "https://profacilitymanagement.de/:path*",
      "destination": "https://www.profacilitymanagement.de/:path*",
      "permanent": true
    },
    {
      "source": "http://profacilitymanagement.de/:path*",
      "destination": "https://www.profacilitymanagement.de/:path*",
      "permanent": true
    },
    {
      "source": "http://www.profacilitymanagement.de/:path*",
      "destination": "https://www.profacilitymanagement.de/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
